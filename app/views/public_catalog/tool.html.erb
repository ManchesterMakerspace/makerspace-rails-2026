<h1><% if page[:wiki_url] %><%= link_to page[:name], page[:wiki_url] %><% else %><%= page[:name] %><% end %></h1>
<p class="description"><%= page[:description] %></p>
<% if page[:shop][:out_of_service] %><p class="status" role="status">Shop out of service. New reservations for this shop and its tools are unavailable.</p><% end %>
<% if page[:out_of_service] %><p class="status" role="status">Out of service — do not use this tool.</p><% end %>
<p><%= link_to page[:shop][:name], "/shop/#{page[:shop][:id]}/public.html" %></p>
<% if page[:open] %>
  <p class="status">No checkout required</p>
<% else %>
  <%= link_to "Request checkout", "/tools/#{page[:id]}/request-checkout", class: "button" %>
<% end %>
<% if (map = page[:map]) %>
  <% shape_points = ->(points) { points.map { |x, y| "#{x},#{y}" }.join(" ") } %>
  <figure class="storage-map">
    <svg viewBox="<%= map[:view_box].join(' ') %>" role="img" aria-label="Map showing where this tool is normally stored" xmlns="http://www.w3.org/2000/svg">
      <image href="<%= image_path("shopFloorPlans/floor-#{map[:floor]}.svg") %>" x="0" y="0" width="<%= map[:image_size][0] %>" height="<%= map[:image_size][1] %>" />
      <% map[:shop_areas].each do |points| %><polygon class="storage-map-area" points="<%= shape_points.call(points) %>" /><% end %>
      <% if map[:tool_shape] %><polygon class="storage-map-tool" points="<%= shape_points.call(map[:tool_shape]) %>" /><% end %>
      <circle class="storage-map-marker" cx="<%= map[:tool_marker][0] %>" cy="<%= map[:tool_marker][1] %>" r="<%= map[:marker_radius] %>" />
    </svg>
    <figcaption>Where this tool is normally stored</figcaption>
  </figure>
<% end %>
<%= render "public_catalog/calendars", calendars: page[:calendars] %>
