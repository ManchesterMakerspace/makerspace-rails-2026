# Each URI must include the database name. Use collection-scoped find privileges.
MLAB_URI=mongodb://display_reader:REPLACE@mongo.example.org/makerauth?tls=true
LEDGER_URI=mongodb://ledger_reader:REPLACE@mongo.example.org/ledger?tls=true
MQTT_HOST=mqtt.example.org
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=welcomepi
MQTT_PASSWORD=REPLACE
# MQTT_CLIENT_ID defaults to welcomepi-<hostname>. Each kiosk needs a unique ID.
# Probe the enabled I2C adapter first, then the UART.
WELCOMEPI_I2C_BUS=/dev/i2c-1
WELCOMEPI_I2C_ADDRESSES=0x24
WELCOMEPI_NFC_PORT=/dev/serial0
# Local syslog by default. Uncomment both settings for direct remote UDP delivery.
# WELCOMEPI_SYSLOG_HOST=192.0.2.10
# WELCOMEPI_SYSLOG_PORT=514
WELCOMEPI_ROTATION=auto
WELCOMEPI_OPPORTUNITIES=5
# Match the Rails organization list and Ledger's exclusion list, if configured.
EVENTBRITE_ORGANIZATION_IDS=
SLACKIDS_INELIGIBLE=[]
# Optional. The credential must be able to read the Ledger bot's private avatar files.
WELCOMEPI_SLACK_TOKEN=
