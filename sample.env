# The hostname part of our visible URL
APP_DOMAIN

# MongoDB Connection
MLAB_URI
MONGO_POOL_SIZE=5

# Shared Rails cache, Sidekiq, locks, and notifications
REDIS_URL=redis://localhost:6379/0

# Web/list performance tuning
RAILS_MAX_THREADS=3
ITEMS_PER_PAGE=50

# Production performance rollout flags for Optimized code
# Boolean flags are enabled only by the exact lowercase value "true".
MONGO_CACHE_ENABLED=false
MONGO_AGGREGATION_ACTIVE_MEMBERS_ENABLED=false
MONGO_AGGREGATION_SPACE_USAGE_ENABLED=false

# Slack Integration
SLACK_SIGNING_SECRET
# Preferred bot token for ordinary API calls.
SLACK_BOT_TOKEN
# Optional user/admin token for privileged Slack API calls.  Without this, some features, like automatic Slack invites, cannot be used.
SLACK_ADMIN_TOKEN

# Mailer Credentials
GMAIL_PASSWORD
GMAIL_USERNAME
# Alternative Mailer credentials
MAILTRAP_ACCOUNT_ID
MAILTRAP_API_TOKEN
MAILTRAP_WEBHOOK_SIGNATURE

# Firebase Federated Authentication KEY and PROJECT_ID are required for Firebase to work
FIREBASE_API_KEY
FIREBASE_PROJECT_ID
FIREBASE_AUTH_DOMAIN
FIREBASE_AUTH_TYPE=token

# Google Integration
GOOGLE_ID
GOOGLE_SECRET
GOOGLE_TOKEN
GOOGLE_CUSTOMER_ID=my_customer
GOOGLE_RESERVATIONS_CALENDAR_ID

# Paypal Integration
PAYPAL_CLIENT_ID
PAYPAL_SECRET
BT_ENV
BT_PRIVATE_KEY
BT_PUBLIC_KEY
BT_MERCHANT_ID
BRAINTREE_OPEN_TIMEOUT=5
BRAINTREE_READ_TIMEOUT=20

# Manchester Makerspace Documents and upload locations
CODE_CONDUCT_ID
CODE_CONDUCT_FOLDER
CONTRACT_ID
MEMBER_CONTRACT_FOLDER
RENTAL_AGREEMENT_ID
RENTAL_AGREEMENT_FOLDER

RESOURCES_FOLDER # Google drive folder for shared member resources
SIGNATURES_FOLDER # Testing folder for signatures
BACKUP_FOLDER # Where db backups are stored

# PROD
SECRET_KEY_BASE
